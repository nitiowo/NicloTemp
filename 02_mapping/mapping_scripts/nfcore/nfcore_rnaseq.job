# Load the nf-core software module
conda activate nfcore-env

# Set the Singularity cache directory
export NXF_SINGULARITY_CACHEDIR=/users/nvincen2/.singularity

# Run the pipeline
nextflow run nf-core/rnaseq \
-profile singularity \
-params-file nf-rnaseq-params-full.yml
